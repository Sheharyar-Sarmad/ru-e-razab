# ============================================
# DEPENDENCIES - IGNORE
# ============================================
/node_modules
/.pnp
.pnp.js
.pnp-lock.yaml
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.gitignore

# ============================================
# NEXT.JS BUILD OUTPUT - IGNORE
# ============================================
/.next/
/out/
/build
/dist
/.vercel
/.turbo
/.cache
/.nextjs
.next-build
.vercel_build

# ============================================
# ENVIRONMENT VARIABLES - IGNORE (EXCEPT .env.example)
# ============================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging
*.env
*.env.*
!.env.example

# ============================================
# LOGS - IGNORE
# ============================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
debug.log
error.log
combined.log
access.log

# ============================================
# OS FILES - IGNORE
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
desktop.ini

# ============================================
# IDE FILES - IGNORE
# ============================================
.idea/
.vscode/
*.iml
*.iws
*.ipr
.metadata/
.settings/
.project
.classpath

# ============================================
# DATABASE FILES - IGNORE
# ============================================
*.sqlite
*.sqlite3
*.db
*.db-journal
*.mongodb
*.dump
*.backup
/data
/database
/prisma/*.db
/prisma/*.sqlite

# ============================================
# UPLOADS & MEDIA - IGNORE
# ============================================
/public/uploads/
/public/images/uploads/
/public/media/
/uploads/
/media/
/temp/
/tmp/
*.mp4
*.mp3
*.wav
*.avi
*.mov
*.mkv

# ============================================
# TESTING & COVERAGE - IGNORE
# ============================================
/coverage
/.nyc_output
/.jest
/__tests__/__snapshots__
*.test.js
*.spec.js
/.test

# ============================================
# TEMPORARY FILES - IGNORE
# ============================================
*.tmp
*.temp
*.cache
.cache/
.temp/
.tmp/

# ============================================
